#include <iostream>
#include <string>
using namespace std;
class dayType {
public:
    void setDay(string d);
    void printDay() const;
    string getDay() const;
    string getNextDay() const;
    string getPreviousDay() const;
    string getDayAfter(int days) const;
    dayType();
    dayType(string d);
private:
    string day;
    static const string daysOfWeek[7];
    int findDayIndex(string d) const; 
};
const string dayType::daysOfWeek[7] = {"Sun", "Mon", "Tue", "Wed", "Thur", "Fri", "Sat"};
dayType::dayType() {
    string userInput;
    cout << "Enter the current day (Sun, Mon, Tue, Wed, Thur, Fri, Sat.): ";
    cin >> userInput;
    setDay(userInput);
}
dayType::dayType(string d) {
    setDay(d);
}
void dayType::setDay(string d) {
    for (const string& validDay : daysOfWeek) { 
        if (validDay == d) {
            day = d;
            return;
        }
    }
    day = "Sun";
    cout << "Invalid input. Defaulting to Sunday.\n";
}
void dayType::printDay() const {
    cout << "Current day: " << day << endl;
}
string dayType::getDay() const {
    return day;
}
string dayType::getNextDay() const {
    int index = findDayIndex(day);
    return daysOfWeek[(index + 1) % 7];
}
string dayType::getPreviousDay() const {
    int index = findDayIndex(day);
    return daysOfWeek[(index + 6) % 7];
}
string dayType::getDayAfter(int days) const {
    int index = findDayIndex(day);
    return daysOfWeek[(index + days) % 7];
}
int dayType::findDayIndex(string d) const {
    for (int i = 0; i < 7; i++) {
        if (daysOfWeek[i] == d) {
            return i;
        }
    }
    return 0; 
}

int main() {
    dayType today;
    today.printDay();

    cout << "Next Day: " << today.getNextDay() << endl;
    cout << "Previous Day: " << today.getPreviousDay() << endl;

    int daysToAdd;
    cout << "Enter number of days to add: ";
    cin >> daysToAdd;
    cout << "Day after " << daysToAdd << " days: " << today.getDayAfter(daysToAdd) << endl;
    return 0;
} 
